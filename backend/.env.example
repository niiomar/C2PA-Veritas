API_KEY=add a key of your choosing
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUDIT_DB_PATH=audit_log.db

# Optional: URL to a PEM-encoded trust anchor bundle. Only fetched when an
# authenticated caller hits POST /api/v1/trust-list/refresh — never per-request.
TRUST_LIST_URL=
TRUST_LIST_CACHE_PATH=trust_list_cache.pem

# Rate limiting on /verify, /verify/batch, and /sign — per API key (or per
# client IP if API_KEY is unset), sliding window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SEC=60
