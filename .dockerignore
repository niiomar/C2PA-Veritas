# Secrets — never let these into the build context or an image layer.
**/.env
!**/.env.example

# Version control / editor
.git
.github
.vscode
.idea

# Python
**/venv/
**/.venv/
**/__pycache__/
**/*.pyc
backend/.pytest_cache/

# Backend runtime/generated data (never needed at build time — the image
# creates its own; a locally-populated one here would just be dead weight,
# or worse, stale data baked into the layer).
backend/*.db
backend/data/
backend/static/
backend/trust_list_cache.pem
backend/trust_list_cache.pem.meta.json

# Frontend — reinstalled/rebuilt fresh inside the frontend-build stage.
frontend/node_modules/
frontend/dist/

# Docs / screenshots — not needed at runtime.
docs/

*.log
